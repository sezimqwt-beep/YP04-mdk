<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Заявки"
        Height="600" Width="1000"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="HelpDesk" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Система обработки заявок" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock x:Name="CurrentUserTextBlock" Text="Пользователь: admin" FontSize="14" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateTextBlock" FontSize="12" Opacity="0.7" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button x:Name="LogoutButton" Grid.Column="2" Content="Выйти" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}" Click="LogoutButton_Click"
                    ToolTip="Выйти из учётной записи"/>
        </Grid>

        <!-- Панель поиска -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Поиск" Margin="0,0,0,5"/>
                <Grid>
                    <TextBox x:Name="SearchTextBox" Height="32" FontSize="14" VerticalContentAlignment="Center"
                             KeyDown="SearchTextBox_KeyDown" ToolTip="Поиск по описанию, категории и статусу (Enter)"/>
                    <TextBlock Text="Описание, категория или статус…" Margin="8,0,0,0" Opacity="0.5"
                               IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox" Height="32" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отклонена"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="SearchButton" Grid.Column="4" Content="Найти" Height="32" VerticalAlignment="Bottom"
                    Click="SearchButton_Click" Cursor="Hand"/>
            <Button x:Name="ResetFilterButton" Grid.Column="6" Content="Сбросить" Height="32" VerticalAlignment="Bottom"
                    Click="ResetFilterButton_Click" Cursor="Hand"/>
        </Grid>

        <DataGrid x:Name="TicketsDataGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" MouseDoubleClick="TicketsDataGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Priority}" Value="Высокий">
                            <Setter Property="Background" Value="#FFFFE0E0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Выполнена">
                            <Setter Property="Background" Value="#FFE2F4E2"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF0078D7"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="180"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="6">
            <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" FontSize="14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddTicketButton" Content="Добавить" Width="120" Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddTicketButton_Click" ToolTip="Создать новую заявку"/>
                <Button x:Name="EditTicketButton" Content="Редактировать" Width="130" Style="{StaticResource PrimaryButtonStyle}"
                        Click="EditTicketButton_Click" ToolTip="Изменить выбранную заявку"/>
                <Button x:Name="DeleteTicketButton" Content="Удалить" Width="120" Style="{StaticResource PrimaryButtonStyle}"
                        Click="DeleteTicketButton_Click" ToolTip="Удалить выбранную заявку"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>