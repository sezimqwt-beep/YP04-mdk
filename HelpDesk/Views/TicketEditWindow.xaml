<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки" Height="580" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="30,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактирование заявки" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="TicketNumberTextBlock" Grid.Row="1" Text="Заявка №: 0" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Text="Категория" Margin="0,10,0,4"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Height="32">
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="ПО"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>
        <TextBlock Grid.Row="4" Text="Описание" Margin="0,10,0,4"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="5" Height="100" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="1000"/>
        <TextBlock Grid.Row="6" Text="Приоритет" Margin="0,10,0,4"/>
        <ComboBox x:Name="PriorityComboBox" Grid.Row="7" Height="32">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>
        <TextBlock Grid.Row="8" Text="Статус" Margin="0,10,0,4"/>
        <ComboBox x:Name="StatusComboBox" Grid.Row="9" Height="32">
            <ComboBoxItem Content="Новая"/>
            <ComboBoxItem Content="В работе"/>
            <ComboBoxItem Content="Выполнена"/>
            <ComboBoxItem Content="Отклонена"/>
        </ComboBox>
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Сохранить изменения" Width="190" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>