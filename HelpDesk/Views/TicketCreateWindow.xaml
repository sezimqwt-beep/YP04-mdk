<Window x:Class="HelpDesk.Views.TicketCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Новая заявка" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новая заявка" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock Grid.Row="2" Text="Категория" Margin="0,0,0,4"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Height="35" FontSize="14"/>
        <TextBlock Grid.Row="5" Text="Описание проблемы" Margin="0,12,0,4"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="6" Height="110" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="1000"/>
        <TextBlock Grid.Row="8" Text="Приоритет" Margin="0,12,0,4"/>
        <ComboBox x:Name="PriorityComboBox" Grid.Row="9" Height="35" FontSize="14"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="130" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="130" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>